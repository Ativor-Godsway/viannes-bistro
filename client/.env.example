# ══════════════════════════════════════════════════════════════════════════════
#  Viannes Bistro storefront — environment
#
#  ⚠️  EVERYTHING HERE IS PUBLIC. Vite inlines any VITE_-prefixed variable into
#  the JavaScript bundle at build time, where anyone can read it. Never put a
#  secret in this file: no Paystack secret key, no JWT secret, no database URI.
#  The API holds all of those.
# ══════════════════════════════════════════════════════════════════════════════

# ── Production (Vercel) ───────────────────────────────────────────────────────
# Absolute URLs, because the client and the API are on different origins.
# Leave BOTH unset locally: they default to relative paths that the Vite dev
# proxy forwards, so local development is unchanged.
#
#   VITE_API_URL     — must include the /api suffix
#   VITE_SOCKET_URL  — origin only, no path
VITE_API_URL=
VITE_SOCKET_URL=

# ── Local development only ────────────────────────────────────────────────────
# Where the Vite dev proxy forwards /api and /socket.io. Not used in a build.
VITE_API_TARGET=http://localhost:3000
