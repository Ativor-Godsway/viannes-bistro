# ══════════════════════════════════════════════════════════════════════════════
#  Besties API — environment
#
#  Copy to `server/.env` for local work. NEVER commit a filled-in copy.
#  Every variable without a default is validated at boot (src/config/env.ts):
#  the server refuses to start and lists what is missing.
# ══════════════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Proxy hops in front of the app. Render = 1. Local = 0.
# Wrong value ⇒ rate limiting buckets every visitor together.
TRUST_PROXY=0

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. No fallback: a missing value is a startup failure, not a silent
# connection to localhost. Use a SEPARATE database for production.
MONGO_URI=mongodb://127.0.0.1:27017/besties

# ── Sessions ──────────────────────────────────────────────────────────────────
# REQUIRED, minimum 32 characters, no default. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS / cookies ────────────────────────────────────────────────────────────
# REQUIRED. Comma-separated, absolute, no trailing slash. Used for CORS, for
# Socket.IO, and as the Paystack callback origin (the first entry).
# A wildcard is impossible here by design: credentialed requests forbid it.
CLIENT_ORIGINS=http://localhost:5173
# Optional regex for ephemeral preview deploys, e.g. Vercel per-PR URLs:
#   CLIENT_ORIGIN_REGEX=^https://besties-[a-z0-9-]+\.vercel\.app$
CLIENT_ORIGIN_REGEX=

# REQUIRED. Where the browser app is SERVED FROM — one canonical URL.
#
# Distinct from CLIENT_ORIGINS above, which is a SET answering "who may call
# this API". This is a single value answering "where do we send a paying
# customer back to", and it is what builds the Paystack redirect
# (<PUBLIC_APP_URL>/payment/callback).
#
# Get it wrong and customers are redirected to the wrong site after paying.
# There is no fallback on purpose: a wrong value must fail at boot, not
# silently produce a wrong redirect. In production it must be https and must
# not be localhost. Normally identical to the entry in CLIENT_ORIGINS; if it
# is not listed there, the server warns at boot.
PUBLIC_APP_URL=http://localhost:5173

# ── Catalogue ─────────────────────────────────────────────────────────────────
# Upserts src/data/catalogue.ts into MongoDB on every boot. NEVER deletes:
# items dropped from the catalogue are hidden, not removed. Safe in production.
SYNC_CATALOGUE_ON_BOOT=true
# Server-authoritative delivery fee, GHS. Any fee in a request body is ignored.
DELIVERY_FEE_GHS=5

# ── Paystack ──────────────────────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
# Test and live are SEPARATE keys with SEPARATE webhook URLs.
# Live mode is opt-in: a live key with PAYSTACK_MODE=test is rejected at boot.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
# Only needed if you rotate the webhook secret independently of the secret key.
# Paystack signs with the secret key by default, which is what we fall back to.
PAYSTACK_WEBHOOK_SECRET=
# The client never needs this — the server initialises the transaction and
# redirects. Kept only if you later add an inline popup.
PAYSTACK_PUBLIC_KEY=

# ── Cloudinary (product photo uploads) ────────────────────────────────────────
# https://console.cloudinary.com → Dashboard → "API Keys"
# All three or none: two out of three fails at boot rather than at upload time.
# Without them the app runs fine; admin image upload returns 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Seeding (destructive dev script only — `npm run seed`) ────────────────────
# No default, minimum 12 characters. The script refuses to run without it, and
# refuses to touch a non-local database unless --force is passed.
SEED_ADMIN_EMAIL=admin@besties.com
SEED_ADMIN_PASSWORD=
